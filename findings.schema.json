{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triple critic loop v2.0 findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_status",
    "reviewed_files",
    "limitations",
    "findings"
  ],
  "properties": {
    "review_status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "title",
          "severity",
          "confidence",
          "impact_dimensions",
          "architectural_reversal",
          "root_cause",
          "affected_component",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "impact_dimensions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "correctness",
                "security",
                "reliability",
                "scalability",
                "operability",
                "maintainability",
                "clarity"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "architectural_reversal": {
            "type": "boolean"
          },
          "root_cause": {
            "type": "string",
            "minLength": 1
          },
          "affected_component": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "location",
              "quote"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "description": "At most 40 words, verbatim from the named frozen file."
              }
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 0
    }
  }
}
