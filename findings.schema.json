{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "triple-critic findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "title",
          "severity",
          "confidence",
          "impact_dimensions",
          "architectural_reversal",
          "root_cause",
          "affected_component",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "finding_id": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "impact_dimensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["correctness", "security", "reliability", "scalability", "operability", "maintainability", "clarity"]
            }
          },
          "architectural_reversal": { "type": "boolean" },
          "root_cause": {
            "type": "string",
            "description": "One phrase naming the underlying defect, not the symptom."
          },
          "affected_component": {
            "type": "string",
            "description": "The section heading (and file name when the target is a directory) the finding is raised against."
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["location", "quote"],
            "properties": {
              "location": { "type": "string" },
              "quote": { "type": "string", "description": "At most 40 words, verbatim from the target." }
            }
          },
          "recommendation": { "type": "string" }
        }
      }
    }
  }
}
